[Desktop Entry]
Type=Application
Name=SLAG
GenericName=Archive Browser
Comment=Simon's Little Archive GUI: browse and extract archives (zip, rar, 7z, tar.gz, split archives)
Exec=@EXEC@ %f
Icon=package-x-generic
Terminal=false
